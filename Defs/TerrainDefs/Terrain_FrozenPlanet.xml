<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <TerrainDef>
    <defName>Stellaris_FrozenGlacialIce</defName>
    <label>冰川冰面</label>
    <description>厚重、光滑的永久冰川表面，反射淡蓝色冷光。冰面可行走，但容易打滑。</description>
    <texturePath>Terrain/Surfaces/Stellaris_FrozenGlacialIce</texturePath>
    <edgeType>FadeRough</edgeType>
    <renderPrecedence>184</renderPrecedence>
    <pathCost>8</pathCost>
    <fertility>0</fertility>
    <takeFootprints>true</takeFootprints>
    <statBases><Beauty>-1</Beauty><Cleanliness>0</Cleanliness></statBases>
    <affordances><li>Light</li><li>Heavy</li><li>Diggable</li></affordances>
    <color>(175,205,220)</color>
    <tags><li>Stellaris_FrozenPlanet</li><li>Stellaris_FrozenPlanet_Ice</li></tags>
  </TerrainDef>

  <TerrainDef>
    <defName>Stellaris_FrozenBlueIce</defName>
    <label>蓝晶冰</label>
    <description>被巨大压力压实的深层蓝冰，半透明且极其滑溜，表面可见被封入其中的暗色裂纹。</description>
    <texturePath>Terrain/Surfaces/Stellaris_FrozenBlueIce</texturePath>
    <edgeType>FadeRough</edgeType>
    <renderPrecedence>190</renderPrecedence>
    <pathCost>12</pathCost>
    <fertility>0</fertility>
