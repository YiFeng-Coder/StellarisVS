<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <BiomeDef>
    <defName>Stellaris_FrozenGlacialPlain</defName>
    <label>冰川平原</label>
    <description>广阔平坦的冰川覆盖区域，冰面光滑，少有障碍物。强风会把细雪吹成贴地漂移的雪雾，冰层深处偶尔夹杂可开采的金属沉积物。</description>
    <workerClass>BiomeWorker_IceSheet</workerClass>
    <implemented>true</implemented>
    <canBuildBase>true</canBuildBase>
    <canAutoChoose>true</canAutoChoose>
    <settleWarning>冰川平原长期处于极低温，暴风雪会进一步降低温度并削弱能见度。殖民者需要可靠供暖、保暖服装和封闭居住空间。</settleWarning>
    <allowFarmingCamps>false</allowFarmingCamps>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <settlementSelectionWeight>0.02</settlementSelectionWeight>
    <movementDifficulty>3.6</movementDifficulty>
    <texture>Biome/Stellaris_FrozenPlanet</texture>
    <forageability>0</forageability>
    <geyserCountFactor>0.15</geyserCountFactor>
    <maxFishPopulation>0</maxFishPopulation>
    <soundsAmbient><li>Ambient_Wind_Desolate</li></soundsAmbient>
    <baseWeatherCommonalities>
      <Stellaris_FrozenStillness>0.62</Stellaris_FrozenStillness>
      <Stellaris_FrozenBlizzard>0.38</Stellaris_FrozenBlizzard>
    </baseWeatherCommonalities>
    <allowRoads>false</allowRoads>
    <allowRivers>false</allowRivers>
    <hasVirtualPlants>false</hasVirtualPlants>
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <terrainsByFertility>
      <li><terrain>Stellaris_FrozenGlacialIce</terrain><min>-999</min><max>0.65</max></li>
      <li><terrain>Stellaris_FrozenDriftSnow</terrain><min>0.65</min><max>0.88</max></li>
      <li><terrain>Stellaris_FrozenBlueIce</terrain><min>0.88</min><max>999</max></li>
    </terrainsByFertility>
    <isExtremeBiome>true</isExtremeBiome>
  </BiomeDef>

  <BiomeDef>
    <defName>Stellaris_FrozenIceCrystalCave</defName>
    <label>冰晶洞穴</label>
    <description>冰川下方的洞穴系统，墙壁与穹顶覆盖着发光冰晶，光线像极光一样在冰面中折射。部分低洼区域有冰下湖泊或地热热泉。</description>
    <workerClass>BiomeWorker_IceSheet</workerClass>
    <implemented>true</implemented>
    <canBuildBase>true</canBuildBase>
    <canAutoChoose>true</canAutoChoose>
    <settleWarning>冰晶洞穴较地表稍稳定，但仍然寒冷潮湿，湿滑冰面与狭窄洞道会拖慢行动。发光冰晶能提供微弱照明，也可能暴露深层裂隙。</settleWarning>
    <allowFarmingCamps>false</allowFarmingCamps>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <settlementSelectionWeight>0.03</settlementSelectionWeight>
    <movementDifficulty>4.0</movementDifficulty>
    <texture>Biome/Stellaris_FrozenIceCrystalCave</texture>
    <forageability>0</forageability>
    <geyserCountFactor>0.8</geyserCountFactor>
    <maxFishPopulation>0</maxFishPopulation>
    <soundsAmbient><li>Ambient_Wind_Desolate</li></soundsAmbient>
    <baseWeatherCommonalities>
      <Stellaris_FrozenStillness>1</Stellaris_FrozenStillness>
    </baseWeatherCommonalities>
    <allowRoads>false</allowRoads>
    <allowRivers>false</allowRivers>
    <hasVirtualPlants>false</hasVirtualPlants>
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <terrainsByFertility>
      <li><terrain>Stellaris_FrozenBlueIce</terrain><min>-999</min><max>0.42</max></li>
      <li><terrain>Stellaris_FrozenCaveIce</terrain><min>0.42</min><max>0.70</max></li>
      <li><terrain>Stellaris_FrozenSubglacialLake</terrain><min>0.70</min><max>0.84</max></li>
      <li><terrain>Stellaris_FrozenThermalSpring</terrain><min>0.84</min><max>999</max></li>
    </terrainsByFertility>
    <isExtremeBiome>true</isExtremeBiome>
  </BiomeDef>

  <BiomeDef>
    <defName>Stellaris_FrozenPolarWasteland</defName>
    <label>极地荒原</label>
    <description>行星极点附近的破碎冻土与冰蚀岩原。这里几乎没有降水，强风持续剥蚀冰层，裸露基岩、冰砾和深层矿脉暴露在极昼与极夜下。</description>
    <workerClass>BiomeWorker_IceSheet</workerClass>
    <implemented>true</implemented>
    <canBuildBase>true</canBuildBase>
    <canAutoChoose>true</canAutoChoose>
    <settleWarning>极地荒原极端寒冷、风力强劲，极昼/极夜会影响光照与情绪。裸露矿脉丰富，但户外行动必须依赖特殊装备。</settleWarning>
    <allowFarmingCamps>false</allowFarmingCamps>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <settlementSelectionWeight>0.01</settlementSelectionWeight>
    <movementDifficulty>4.8</movementDifficulty>
    <texture>Biome/Stellaris_FrozenPolarWasteland</texture>
    <forageability>0</forageability>
    <geyserCountFactor>0.05</geyserCountFactor>
    <maxFishPopulation>0</maxFishPopulation>
    <soundsAmbient><li>Ambient_Wind_Desolate</li></soundsAmbient>
    <baseWeatherCommonalities>
      <Stellaris_FrozenStillness>0.55</Stellaris_FrozenStillness>
      <Stellaris_FrozenBlizzard>0.45</Stellaris_FrozenBlizzard>
    </baseWeatherCommonalities>
    <allowRoads>false</allowRoads>
    <allowRivers>false</allowRivers>
    <hasVirtualPlants>false</hasVirtualPlants>
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <terrainsByFertility>
      <li><terrain>Stellaris_FrozenPermafrost</terrain><min>-999</min><max>0.45</max></li>
      <li><terrain>Stellaris_FrozenIcyGravel</terrain><min>0.45</min><max>0.78</max></li>
      <li><terrain>Stellaris_FrozenErodedRock</terrain><min>0.78</min><max>999</max></li>
    </terrainsByFertility>
    <isExtremeBiome>true</isExtremeBiome>
  </BiomeDef>
</Defs>
