<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <BiomeDef>
    <defName>Stellaris_LostSilentCity</defName>
    <label>寂静城区</label>
    <description>曾经繁华的城市中心，如今只剩摩天楼残骸、坍塌高架与遍布弹坑的广场。部分建筑内部仍可通行，废弃终端、家具残骸和数据核心散落在静默街区中。</description>
    <workerClass>BiomeWorker_Desert</workerClass>
    <implemented>true</implemented>
    <canBuildBase>true</canBuildBase>
    <canAutoChoose>true</canAutoChoose>
    <settleWarning>遗落行星的城市废墟富含资源与远古科技碎片，但也存在建筑坍塌、残留防御系统、毒性粉尘和未知污染。

建议携带过滤呼吸器、防辐射装备以及足够的火力。</settleWarning>
    <allowFarmingCamps>false</allowFarmingCamps>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <settlementSelectionWeight>0</settlementSelectionWeight>
    <movementDifficulty>3.2</movementDifficulty>
    <texture>Biome/Stellaris_LostSilentCity</texture>
    <forageability>0</forageability>
    <geyserCountFactor>0</geyserCountFactor>
    <maxFishPopulation>0</maxFishPopulation>
    <soundsAmbient><li>Ambient_Wind_Desolate</li></soundsAmbient>
    <baseWeatherCommonalities>
      <Stellaris_LostAshHaze>0.75</Stellaris_LostAshHaze>
      <Stellaris_LostCorrosiveDrizzle>0.15</Stellaris_LostCorrosiveDrizzle>
      <Stellaris_LostReactorGlow>0.10</Stellaris_LostReactorGlow>
    </baseWeatherCommonalities>
    <allowRoads>false</allowRoads>
    <allowRivers>false</allowRivers>
    <hasVirtualPlants>false</hasVirtualPlants>
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <terrainsByFertility>
      <li><terrain>Stellaris_LostUrbanRubble</terrain><min>-999</min><max>0.72</max></li>
      <li><terrain>Stellaris_LostCrackedAsphalt</terrain><min>0.72</min><max>999</max></li>
    </terrainsByFertility>
    <isExtremeBiome>true</isExtremeBiome>
  </BiomeDef>

  <BiomeDef>
    <defName>Stellaris_LostRustedPlain</defName>
    <label>锈蚀平原</label>
    <description>广阔的废弃工业区与物流枢纽，被氧化铁染成深红褐色。精炼塔、管道网络和巨型运输载具残骸散落其间，低洼处常有酸性泥坑与泄漏的化学残余。</description>
    <workerClass>BiomeWorker_Desert</workerClass>
    <implemented>true</implemented>
    <canBuildBase>true</canBuildBase>
    <canAutoChoose>true</canAutoChoose>
    <settleWarning>锈蚀平原拥有巨量钢铁、化合燃料、铀与自动化残骸，但酸雨、化学泄漏和反应堆污染会持续磨损装备并伤害暴露人员。</settleWarning>
    <allowFarmingCamps>false</allowFarmingCamps>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <settlementSelectionWeight>0</settlementSelectionWeight>
    <movementDifficulty>4.0</movementDifficulty>
    <texture>Biome/Stellaris_LostRustedPlain</texture>
    <forageability>0</forageability>
    <geyserCountFactor>0</geyserCountFactor>
    <maxFishPopulation>0</maxFishPopulation>
    <soundsAmbient><li>Ambient_Wind_Desolate</li></soundsAmbient>
    <baseWeatherCommonalities>
      <Stellaris_LostCorrosiveDrizzle>0.55</Stellaris_LostCorrosiveDrizzle>
      <Stellaris_LostAshHaze>0.30</Stellaris_LostAshHaze>
      <Stellaris_LostReactorGlow>0.15</Stellaris_LostReactorGlow>
    </baseWeatherCommonalities>
    <allowRoads>false</allowRoads>
    <allowRivers>false</allowRivers>
    <hasVirtualPlants>false</hasVirtualPlants>
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <terrainsByFertility>
      <li><terrain>Stellaris_LostIndustrialSlag</terrain><min>-999</min><max>0.64</max></li>
      <li><terrain>Stellaris_LostCorrosiveMud</terrain><min>0.64</min><max>999</max></li>
    </terrainsByFertility>
    <isExtremeBiome>true</isExtremeBiome>
  </BiomeDef>

  <BiomeDef>
    <defName>Stellaris_LostGlassPlain</defName>
    <label>玻璃平原</label>
    <description>极端热能瞬间冲击形成的熔融凝固地貌。城市与生命在一瞬间消失，只留下光滑扭曲的硅酸盐玻璃、熔铸金属雕塑和地面上的永恒阴影。</description>
    <workerClass>BiomeWorker_Desert</workerClass>
    <implemented>true</implemented>
    <canBuildBase>true</canBuildBase>
    <canAutoChoose>true</canAutoChoose>
    <settleWarning>玻璃平原地表锋利且带有衰变辐射。这里偶尔能找到被熔封但完整保存的数据核心，但长期暴露非常危险。</settleWarning>
    <allowFarmingCamps>false</allowFarmingCamps>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <settlementSelectionWeight>0</settlementSelectionWeight>
    <movementDifficulty>4.8</movementDifficulty>
    <texture>Biome/Stellaris_LostGlassPlain</texture>
    <forageability>0</forageability>
    <geyserCountFactor>0</geyserCountFactor>
    <maxFishPopulation>0</maxFishPopulation>
    <soundsAmbient><li>Ambient_Wind_Desolate</li></soundsAmbient>
    <baseWeatherCommonalities>
      <Stellaris_LostReactorGlow>0.5</Stellaris_LostReactorGlow>
      <Stellaris_LostAshHaze>0.5</Stellaris_LostAshHaze>
    </baseWeatherCommonalities>
    <allowRoads>false</allowRoads>
    <allowRivers>false</allowRivers>
    <hasVirtualPlants>false</hasVirtualPlants>
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <terrainsByFertility>
      <li><terrain>Stellaris_LostFusedGlass</terrain><min>-999</min><max>0.78</max></li>
      <li><terrain>Stellaris_LostShadowImprint</terrain><min>0.78</min><max>999</max></li>
    </terrainsByFertility>
    <isExtremeBiome>true</isExtremeBiome>
  </BiomeDef>
</Defs>
