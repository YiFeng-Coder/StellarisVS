<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>Stellaris_FusionReactor</defName>
    <label>复原型聚变反应堆</label>
    <description>根据古代聚变蓝图复原的殖民地级能源设施。它平时稳定而安静地输出巨量电力，不需要日常维护；启动时需要长时间预热，停堆时也需要受控降功率冷却。在启动、运行或停堆尚未完成时被外力打穿，磁约束腔会发生连续破裂，引发多轮爆炸、EMP、火灾、燃料殉爆和地面玻璃化。</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Power/Stellaris_FusionReactor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(6.8,6.8)</drawSize>
      <shadowData>
        <volume>(5.6,1.0,5.6)</volume>
        <offset>(0,0,-0.1)</offset>
      </shadowData>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>1.0</fillPercent>
    <pathCost>80</pathCost>
    <rotatable>false</rotatable>
    <blockWind>true</blockWind>
    <blockLight>true</blockLight>
    <castEdgeShadows>true</castEdgeShadows>
    <canOverlapZones>false</canOverlapZones>
    <size>(6,6)</size>
    <tickerType>Normal</tickerType>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <constructEffect>ConstructMetal</constructEffect>
    <statBases>
      <MaxHitPoints>2400</MaxHitPoints>
      <WorkToBuild>36000</WorkToBuild>
      <Mass>1200</Mass>
      <Flammability>0</Flammability>
      <Beauty>-20</Beauty>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
    </building>
    <costList>
      <Steel>4000</Steel>
      <Plasteel>1600</Plasteel>
      <Uranium>400</Uranium>
      <Gold>200</Gold>
      <ComponentIndustrial>60</ComponentIndustrial>
      <ComponentSpacer>30</ComponentSpacer>
      <Stellaris_AncientTechFragment>40</Stellaris_AncientTechFragment>
      <Stellaris_FusionControlDataCore>1</Stellaris_FusionControlDataCore>
      <Stellaris_AncientFusionCoreModule>1</Stellaris_AncientFusionCoreModule>
      <Stellaris_AncientFuelInjector>2</Stellaris_AncientFuelInjector>
    </costList>
    <comps>
      <li Class="Stellaris.CompProperties_StellarisFusionReactor">
        <basePowerConsumption>-80000</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
        <soundAmbientProducingPower>ChemfuelFiredGenerator_Ambience</soundAmbientProducingPower>
        <breachHitPointFraction>0.20</breachHitPointFraction>
        <breachCheckInterval>60</breachCheckInterval>
        <breachWarningDelayTicks>120</breachWarningDelayTicks>
        <startupTicks>15000</startupTicks>
        <shutdownTicks>7500</shutdownTicks>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0.083333</fuelConsumptionRate>
        <fuelCapacity>4.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>Stellaris_DeuteriumTritiumFuel</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>0</initialFuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>12</glowRadius>
        <glowColor>(70,145,180,0)</glowColor>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>12</heatPerSecond>
      </li>
      <li Class="CompProperties_Stunnable">
        <useLargeEMPEffecter>true</useLargeEMPEffecter>
        <affectedDamageDefs>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
    </comps>
    <designationCategory>Power</designationCategory>
    <uiOrder>2600</uiOrder>
    <designationHotKey>Misc4</designationHotKey>
    <researchPrerequisites>
      <li>StellarisResearch_NuclearFusionReactor</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
  </ThingDef>
</Defs>
