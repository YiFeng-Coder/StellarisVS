<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>Stellaris_FusionReactorBlueprint</defName>
    <label>完整聚变反应堆蓝图</label>
    <description>从古代聚变核心中完整恢复的反应堆蓝图。它不是一次性建造材料，也不是原版科技蓝图商品。选择该物品并解析蓝图数据后，才能开始研究聚变反应堆。</description>
    <graphicData><texPath>Things/Item/Resource/Stellaris_FusionReactorBlueprint</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>0.85</drawSize></graphicData>
    <stackLimit>1</stackLimit><healthAffectsPrice>false</healthAffectsPrice><soundInteract>Standard_Drop</soundInteract><soundDrop>Standard_Drop</soundDrop>
    <statBases><MarketValue>10000</MarketValue><Mass>0.5</Mass><Flammability>0.2</Flammability><DeteriorationRate>0.1</DeteriorationRate></statBases>
    <tradeability>None</tradeability>
    <thingCategories><li>ResourcesRaw</li></thingCategories>
    <comps>
      <li Class="Stellaris.CompProperties_StellarisArchaeologicalBlueprint">
        <researchProject>StellarisResearch_NuclearFusionReactor</researchProject>
        <destroyOnApply>true</destroyOnApply>
      </li>
    </comps>
  </ThingDef>

