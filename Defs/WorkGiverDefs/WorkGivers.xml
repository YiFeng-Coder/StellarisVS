<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <WorkGiverDef>
    <defName>StellarisPlanetScannerWorkGiver</defName>
    <label>在天体扫描仪扫描</label>
    <giverClass>Stellaris.WorkGiver_OperatePlanetScanner</giverClass>
    <workType>Research</workType>
    <priorityInType>50</priorityInType>
    <verb>扫描</verb>
    <gerund>扫描</gerund>
    <scannerDef>StellarisPlanetScanner</scannerDef>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
  </WorkGiverDef>
  <!-- 分配工作的规则 -->
  <!-- 这里的 workType 使用了 Research (研究)，意味着只有负责研究的人才会去做 -->
  <WorkGiverDef>
    <defName>Stellaris_DoReverseEngineer</defName>
    <label>逆向工程外星建筑</label>
    <giverClass>Stellaris.WorkGiver_ReverseEngineer</giverClass>
    <workType>Research</workType>
    <priorityInType>90</priorityInType>
    <!-- 优先级很高，优先于普通研究 -->
    <verb>逆向工程</verb>
    <gerund>正在逆向工程</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>
</Defs>