<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <Stellaris.PlanetDef>
    <defName>Stellaris_FrozenPlanet</defName>
    <label>冰封行星</label>
    <description>一颗表面被永久冰川、雪原或冻土覆盖的寒冷世界。大气稀薄或中等，常见冰晶云、极地涡旋和极光环；液态水几乎只存在于冰下深层湖泊、冰晶洞穴或地热活跃区。</description>
    <colorOutLine>
      <r>0.68</r>
      <g>0.86</g>
      <b>1</b>
      <a>1</a>
    </colorOutLine>
    <resourceConfigs>
      <li><thing>Steel</thing><chance>1</chance></li>
      <li><thing>Uranium</thing><chance>0.55</chance></li>
      <li><thing>Plasteel</thing><chance>0.35</chance></li>
      <li><thing>ComponentIndustrial</thing><chance>0.35</chance></li>
    </resourceConfigs>
    <temperatureRange>(-150,-40)</temperatureRange>
    <habitableChance>0.25</habitableChance>
    <canBeGeneratedNaturally>true</canBeGeneratedNaturally>
  </Stellaris.PlanetDef>
</Defs>
