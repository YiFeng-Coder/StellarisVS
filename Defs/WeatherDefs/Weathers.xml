      <shadow>(0,0,0)</shadow>
      <overlay>(0.025,0.028,0.04)</overlay>
      <saturation>0.15</saturation>
    </skyColorsNightMid>
  </WeatherDef>
  <WeatherDef>
    <defName>Stellaris_ElectrostaticDust</defName>
    <label>静电尘暴</label>
    <description>没有大气层中的风，却有静电荷失衡引发的粉尘喷涌。细粉尘会遮蔽视线、干扰设备，并让所有户外行动变得困难。</description>
    <repeatable>true</repeatable>
    <favorability>VeryBad</favorability>
    <perceivePriority>0</perceivePriority>
    <skyColorsDay>
      <sky>(0.45,0.45,0.42)</sky>
      <shadow>(0.10,0.10,0.11)</shadow>
      <overlay>(0.62,0.62,0.56)</overlay>
      <saturation>0.35</saturation>
    </skyColorsDay>
    <skyColorsDusk>
