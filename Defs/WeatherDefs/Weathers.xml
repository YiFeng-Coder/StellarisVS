<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <WeatherDef>
    <defName>StellarisNoOxygen</defName>
    <label>缺氧环境</label>
    <description>这是缺氧环境。通常出现在非宜居行星上。</description>
    <repeatable>true</repeatable>
    <favorability>Good</favorability>
    <perceivePriority>0</perceivePriority>
    <skyColorsDay>
      <sky>(1,1,1)</sky>
      <shadow>(0.718,0.745,0.757)</shadow>
      <overlay>(1,1,1)</overlay>
      <saturation>1.25</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.74,0.80,0.84)</sky>
      <shadow>(0.955,0.886,0.914)</shadow>
      <overlay>(0.8,0.8,0.8)</overlay>
      <saturation>1.25</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.482,0.603,0.682)</sky>
      <shadow>(1,1,1)</shadow>
      <overlay>(0.6,0.6,0.6)</overlay>
      <saturation>1.25</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.482,0.603,0.682)</sky>
      <shadow>(1,1,1)</shadow>
      <overlay>(0.6,0.6,0.6)</overlay>
      <saturation>1.25</saturation>
    </skyColorsNightMid>
  </WeatherDef>
  <WeatherDef>
    <defName>StellarisAcidSmog</defName>
    <label>硫酸烟雾</label>
    <description>一层厚重且令人窒息的硫磺云层和高压雾霾。会对绝大多数衣物造成腐蚀。</description>
    <!-- 即使是晴天逻辑，也不要移动风向，制造那种死气沉沉的压抑感 -->
    <repeatable>true</repeatable>
    <favorability>VeryBad</favorability>
    <!-- 看不清 -->
    <ambientSounds>
      <li>Ambient_Wind_Storm</li>
    </ambientSounds>
    <!-- 视觉核心：黄色/橙色滤镜 -->
    <skyColorsDay>
      <sky>(0.8, 0.6, 0.2)</sky>
      <!-- 土黄色天空 -->
      <shadow>(0.6, 0.5, 0.2)</shadow>
      <overlay>(0.8, 0.6, 0.2)</overlay>
      <!-- 强烈的黄色覆盖层 -->
      <saturation>0.8</saturation>
      <!-- 高饱和度 -->
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.6, 0.3, 0.1)</sky>
      <shadow>(0.5, 0.3, 0.1)</shadow>
      <overlay>(0.6, 0.3, 0.1)</overlay>
      <saturation>0.7</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.2, 0.15, 0.05)</sky>
      <!-- 夜晚是暗淡的棕色，不是黑色 -->
      <shadow>(0.1, 0.05, 0.0)</shadow>
      <overlay>(0.2, 0.15, 0.05)</overlay>
      <saturation>0.5</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.2, 0.15, 0.05)</sky>
      <!-- 夜晚是暗淡的棕色，不是黑色 -->
      <shadow>(0.1, 0.05, 0.0)</shadow>
      <overlay>(0.2, 0.15, 0.05)</overlay>
      <saturation>0.5</saturation>
    </skyColorsNightMid>
    <!-- 精度惩罚：雾太浓了 -->
    <accuracyMultiplier>0.6</accuracyMultiplier>
    <!-- 移动惩罚：这里不仅是Biome难走，天气也让你难受 -->
    <moveSpeedMultiplier>0.8</moveSpeedMultiplier>
  </WeatherDef>

  <WeatherDef>
    <defName>Stellaris_DeadStillness</defName>
    <label>绝对死寂</label>
    <description>没有风、没有云、没有任何声音传播介质。恒星光线直接照射地表，阴影区域则迅速坠入极寒。</description>
    <repeatable>true</repeatable>
    <favorability>VeryBad</favorability>
    <perceivePriority>0</perceivePriority>
    <skyColorsDay>
      <sky>(0.62,0.61,0.58)</sky>
      <shadow>(0.15,0.15,0.16)</shadow>
      <overlay>(0.82,0.80,0.75)</overlay>
      <saturation>0.55</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.38,0.35,0.32)</sky>
      <shadow>(0.12,0.11,0.13)</shadow>
      <overlay>(0.52,0.48,0.42)</overlay>
