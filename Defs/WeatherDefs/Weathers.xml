    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.02,0.025,0.035)</sky>
      <shadow>(0,0,0)</shadow>
      <overlay>(0.05,0.055,0.07)</overlay>
      <saturation>0.25</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
